<Window x:Class="ChromeBookmarksManager.BookmarkEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        MinHeight="180"
        MaxHeight="320"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="NamePanel" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{DynamicResource FieldName}" />
            <TextBox x:Name="NameBox"
                     Grid.Column="1"
                     MinWidth="360"
                     VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="UrlPanel" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{DynamicResource FieldUrl}" />
            <TextBox x:Name="UrlBox"
                     Grid.Column="1"
                     MinWidth="360"
                     VerticalContentAlignment="Center" />
        </Grid>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Margin="70,0,0,12"
                   MinHeight="18"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource ButtonOk}"
                    Width="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Ok_Click" />
            <Button Content="{DynamicResource ButtonCancel}"
                    Width="88"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
