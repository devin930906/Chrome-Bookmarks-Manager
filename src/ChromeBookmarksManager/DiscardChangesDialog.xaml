<Window x:Class="ChromeBookmarksManager.DiscardChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DiscardTitle}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="{DynamicResource DiscardHeading}" />
            <TextBlock Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="{DynamicResource DiscardBody}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource ButtonCancel}"
                    Width="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    IsCancel="True" />
            <Button Content="{DynamicResource ButtonDiscard}"
                    Width="88"
                    Click="Discard_Click" />
        </StackPanel>
    </Grid>
</Window>
