<Window x:Class="ChromeBookmarksManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:search="clr-namespace:ChromeBookmarksManager.Application.Search"
        Title="{Binding ApplicationTitle}" Icon="Assets/ChromeBookmarksManager.ico"
        Style="{StaticResource WorkspaceWindowStyle}"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="QuietLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="FontSize" Value="11" /></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Menu Grid.Row="0" Padding="8,3" Background="{DynamicResource SidebarBackgroundBrush}">
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuOpenBookmarks}"
                          IsEnabled="{Binding CanOpenBookmarks}"
                          Click="OpenBookmarks_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuImportBookmarksHtml}"
                          IsEnabled="{Binding CanImportBookmarksHtml}"
                          Click="ImportBookmarksHtml_Click" />
                <MenuItem Header="{DynamicResource MenuExportBookmarksHtml}"
                          IsEnabled="{Binding CanExportBookmarksHtml}"
                          Click="ExportBookmarksHtml_Click" />
                <MenuItem Header="{DynamicResource MenuSave}"
                          InputGestureText="Ctrl+S"
                          IsEnabled="{Binding CanSave}"
                          Click="Save_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuExit}"
                          Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuEdit}">
                <MenuItem Header="{DynamicResource MenuUndo}"
                          InputGestureText="Ctrl+Z"
                          IsEnabled="{Binding CanUndo}"
                          ToolTip="{Binding UndoDescription}"
                          Click="Undo_Click" />
                <MenuItem Header="{DynamicResource MenuRedo}"
                          InputGestureText="Ctrl+Y / Ctrl+Shift+Z"
                          IsEnabled="{Binding CanRedo}"
                          ToolTip="{Binding RedoDescription}"
                          Click="Redo_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuCut}"
                          InputGestureText="Ctrl+X"
                          IsEnabled="{Binding CanCutSelectedContentItems}"
                          Click="CutSelectedContentItems_Click" />
                <MenuItem Header="{DynamicResource MenuCopy}"
                          InputGestureText="Ctrl+C"
                          IsEnabled="{Binding CanCopySelectedContentItems}"
                          Click="CopySelectedContentItems_Click" />
                <MenuItem Header="{DynamicResource MenuPaste}"
                          InputGestureText="Ctrl+V"
                          IsEnabled="{Binding CanPasteClipboard}"
                          Click="PasteClipboard_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuAddBookmark}"
                          InputGestureText="Ctrl+Shift+B"
                          IsEnabled="{Binding CanAddBookmark}"
                          Click="AddBookmark_Click" />
                <MenuItem Header="{DynamicResource MenuAddBookmarksBatch}"
                          IsEnabled="{Binding CanAddBookmark}"
                          Click="AddBookmarksBatch_Click" />
                <MenuItem Header="{DynamicResource MenuAddFolder}"
                          InputGestureText="Ctrl+Shift+F"
                          IsEnabled="{Binding CanAddFolder}"
                          Click="AddFolder_Click" />
                <MenuItem Header="{DynamicResource MenuSortByName}"
                          IsEnabled="{Binding CanSortSelectedFolder}"
                          Click="SortSelectedFolder_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuRenameFolder}"
                          InputGestureText="F2"
                          IsEnabled="{Binding CanRenameSelectedFolder}"
                          Click="RenameFolder_Click" />
                <MenuItem Header="{DynamicResource MenuRenameBookmark}"
                          InputGestureText="F2"
                          IsEnabled="{Binding CanRenameSelectedBookmark}"
                          Click="RenameBookmark_Click" />
                <MenuItem Header="{DynamicResource MenuEditUrl}"
                          InputGestureText="Ctrl+E"
                          IsEnabled="{Binding CanEditSelectedBookmarkUrl}"
                          Click="EditUrl_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuDeleteSelectedItems}"
                          InputGestureText="Delete"
                          IsEnabled="{Binding CanDeleteSelectedContentItems}"
                          Click="DeleteSelectedContentItems_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuView}">
                <MenuItem x:Name="LightModeMenuItem" Header="{DynamicResource ThemeLight}" IsCheckable="True" Click="LightMode_Click" />
                <MenuItem x:Name="DarkModeMenuItem" Header="{DynamicResource ThemeDark}" IsCheckable="True" Click="DarkMode_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuAppearance}" Click="ShowAppearance_Click" />
                <MenuItem Header="{DynamicResource MenuDetails}" Click="ToggleDetails_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuLanguage}">
                <MenuItem x:Name="SimplifiedChineseMenuItem"
                          Header="{DynamicResource LanguageSimplifiedChinese}"
                          IsCheckable="True"
                          Click="SwitchToSimplifiedChinese_Click" />
                <MenuItem x:Name="EnglishMenuItem"
                          Header="{DynamicResource LanguageEnglish}"
                          IsCheckable="True"
                          Click="SwitchToEnglish_Click" />
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1" x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="170" MaxWidth="330" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition x:Name="DetailsSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="DetailsColumn" Width="225" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SidebarBackgroundBrush}" Padding="12,16,10,10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource WorkspaceBrand}" FontWeight="SemiBold" FontSize="18" Margin="8,0,0,18" />
                    <Button Grid.Row="1" Content="{DynamicResource ToolbarOpenBookmarks}" Click="OpenBookmarks_Click" IsEnabled="{Binding CanOpenBookmarks}" ToolTip="{DynamicResource TooltipOpenBookmarks}" HorizontalAlignment="Stretch" Margin="0,0,0,18" />
                    <GroupBox Grid.Row="2" Header="{DynamicResource PanelFolders}" Padding="0" BorderThickness="0">
                        <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding FolderRoots}"
                          IsEnabled="{Binding CanBrowseDocument}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="FolderTree_PreviewMouseMove"
                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          DragOver="FolderTree_DragOver"
                          DragLeave="FolderTree_DragLeave"
                          Drop="FolderTree_Drop"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource ContextAddBookmark}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmark_Click" />
                            <MenuItem Header="{DynamicResource ContextAddBookmarksBatch}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmarksBatch_Click" />
                            <MenuItem Header="{DynamicResource ContextAddFolder}"
                                      IsEnabled="{Binding CanAddFolder}"
                                      Click="AddFolder_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ContextRenameFolder}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedFolder}"
                                      Click="RenameFolder_Click" />
                            <MenuItem Header="{DynamicResource ContextMoveTo}"
                                      IsEnabled="{Binding CanMoveSelectedFolder}"
                                      Click="MoveFolder_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ContextDeleteFolder}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedFolder}"
                                      Click="DeleteSelectedFolder_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▱" Margin="0,0,7,0" Foreground="{DynamicResource WarningBrush}" /><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource WorkspaceTreeItemStyle}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
                    </GroupBox>
                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="7,12,4,0" Margin="0,10,0,0">
                        <StackPanel><TextBlock Text="{Binding Workspace.SourceFileName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" /><TextBlock Text="{Binding SourcePath}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Background="{DynamicResource BorderBrush}" />
            <Grid Grid.Column="2" Margin="16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="0,14,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" MinWidth="75" Margin="0,0,8,0" Height="34" VerticalContentAlignment="Center" IsEnabled="{Binding CanSearchDocument}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource TooltipSearch}" />
                        <ComboBox Grid.Column="1" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" IsEnabled="{Binding CanSearchDocument}" SelectedValue="{Binding SearchScope, Mode=TwoWay}" SelectedValuePath="Tag" ToolTip="{DynamicResource TooltipSearchScope}">
                            <ComboBoxItem Content="{DynamicResource SearchScopeAllBookmarks}" Tag="{x:Static search:BookmarkSearchScope.AllBookmarks}" />
                            <ComboBoxItem Content="{DynamicResource SearchScopeCurrentFolder}" Tag="{x:Static search:BookmarkSearchScope.CurrentFolder}" />
                        </ComboBox>
                        <Button Grid.Column="2" x:Name="ThemeToggleButton" Content="{DynamicResource ThemeToggle}" Click="ToggleTheme_Click" ToolTip="{Binding Workspace.ThemeDescription, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0" Padding="10,6" />
                        <Button Grid.Column="3" Content="{DynamicResource ToolbarSave}" IsEnabled="{Binding CanSave}" Click="Save_Click" ToolTip="{DynamicResource TooltipSave}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="2,19,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Workspace.FolderPath, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workspace.FolderPath, RelativeSource={RelativeSource AncestorType=Window}}" /><TextBlock Text="{Binding Workspace.FolderTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workspace.FolderTitle, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,5,0,5" /><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Workspace.DisplayedSummary, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource QuietLabel}" /><TextBlock Text="{DynamicResource WorkspaceUnsaved}" Foreground="{DynamicResource WarningBrush}" Margin="12,0,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolVisibility}}" /></StackPanel></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="{DynamicResource ToolbarUndo}" IsEnabled="{Binding CanUndo}" Click="Undo_Click" ToolTip="{Binding UndoDescription}" Style="{StaticResource QuietButtonStyle}" Padding="6,4" MinWidth="46" Margin="0,0,5,0" />
                        <Button Content="{DynamicResource ToolbarRedo}" IsEnabled="{Binding CanRedo}" Click="Redo_Click" ToolTip="{Binding RedoDescription}" Style="{StaticResource QuietButtonStyle}" Padding="6,4" MinWidth="46" Margin="0,0,5,0" />
                        <Button Content="{DynamicResource WorkspaceAdd}" Click="ShowAddMenu_Click" IsEnabled="{Binding CanAddBookmark}" Style="{StaticResource PrimaryButtonStyle}"><Button.ContextMenu><ContextMenu><MenuItem Header="{DynamicResource MenuAddBookmark}" IsEnabled="{Binding CanAddBookmark}" Click="AddBookmark_Click" /><MenuItem Header="{DynamicResource MenuAddBookmarksBatch}" IsEnabled="{Binding CanAddBookmark}" Click="AddBookmarksBatch_Click" /><MenuItem Header="{DynamicResource MenuAddFolder}" IsEnabled="{Binding CanAddFolder}" Click="AddFolder_Click" /></ContextMenu></Button.ContextMenu></Button>
                        <Button Content="{DynamicResource WorkspaceDetails}" Click="ToggleDetails_Click" Visibility="{Binding Workspace.IsDetailsClosed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
                <Border x:Name="BulkActionsBar" Grid.Row="2" Background="{DynamicResource SelectionBrush}" CornerRadius="6" Padding="9,7" Margin="0,0,0,10" Visibility="{Binding Workspace.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                    <DockPanel><TextBlock Text="{Binding Workspace.SelectedSummary, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" FontSize="11" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource ContextCut}" IsEnabled="{Binding CanCutSelectedContentItems}" Click="CutSelectedContentItems_Click" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="{DynamicResource ContextCopy}" IsEnabled="{Binding CanCopySelectedContentItems}" Click="CopySelectedContentItems_Click" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="{DynamicResource WorkspaceMove}" IsEnabled="{Binding CanMoveSelectedContentItems}" Click="MoveSelectedContentItems_Click" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="{DynamicResource WorkspaceDelete}" IsEnabled="{Binding CanDeleteSelectedContentItems}" Click="DeleteSelectedContentItems_Click" Style="{StaticResource DangerButtonStyle}" />
                        <Button Content="×" Click="ClearSelection_Click" Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource WorkspaceClearSelection}" />
                    </StackPanel></DockPanel>
                </Border>
                <GroupBox Grid.Row="3" Header="{DynamicResource PanelContents}" BorderThickness="0" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,9"><Button Content="{DynamicResource MenuSortByName}" IsEnabled="{Binding CanSortSelectedFolder}" Click="SortSelectedFolder_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" /><TextBlock Text="{Binding SearchSummaryText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
                        <Grid Grid.Row="1"><ListView x:Name="BookmarksList" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"
                          ItemsSource="{Binding DisplayedItems}"
                          SelectionChanged="BookmarksList_SelectionChanged"
                          MouseDoubleClick="BookmarksList_MouseDoubleClick"
                          KeyDown="BookmarksList_KeyDown"
                          PreviewMouseLeftButtonDown="BookmarksList_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="BookmarksList_PreviewMouseMove"
                          PreviewMouseRightButtonDown="BookmarksList_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          DragOver="BookmarksList_DragOver"
                          DragLeave="BookmarksList_DragLeave"
                          Drop="BookmarksList_Drop"
                          SelectionMode="Extended"
                          IsEnabled="{Binding CanBrowseDocument}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Opened="BookmarksContextMenu_Opened">
                            <MenuItem x:Name="ContentOpenFolderMenuItem"
                                      Header="{DynamicResource ContextOpenFolder}"
                                      IsEnabled="{Binding CanOpenSelectedContentItem}"
                                      Click="OpenContentFolder_Click" />
                            <MenuItem x:Name="ContentOpenBookmarkMenuItem"
                                      Header="{DynamicResource ContextOpenBookmark}"
                                      IsEnabled="{Binding CanOpenSelectedContentItem}"
                                      Visibility="Collapsed"
                                      Click="OpenContentBookmark_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ContextCut}"
                                      InputGestureText="Ctrl+X"
                                      IsEnabled="{Binding CanCutSelectedContentItems}"
                                      Click="CutSelectedContentItems_Click" />
                            <MenuItem Header="{DynamicResource ContextCopy}"
                                      InputGestureText="Ctrl+C"
                                      IsEnabled="{Binding CanCopySelectedContentItems}"
                                      Click="CopySelectedContentItems_Click" />
                            <MenuItem Header="{DynamicResource ContextPaste}"
                                      InputGestureText="Ctrl+V"
                                      IsEnabled="{Binding CanPasteClipboard}"
                                      Click="PasteClipboard_Click" />
                            <MenuItem x:Name="ContentAddBookmarkMenuItem"
                                      Header="{DynamicResource ContextAddBookmark}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmark_Click" />
                            <MenuItem x:Name="ContentAddBookmarksBatchMenuItem"
                                      Header="{DynamicResource ContextAddBookmarksBatch}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmarksBatch_Click" />
                            <MenuItem x:Name="ContentAddFolderMenuItem"
                                      Header="{DynamicResource ContextAddFolder}"
                                      IsEnabled="{Binding CanAddFolder}"
                                      Click="AddFolder_Click" />
                            <Separator />
                            <MenuItem x:Name="ContentRenameFolderMenuItem"
                                      Header="{DynamicResource ContextRenameFolder}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedContentFolder}"
                                      Click="RenameContentFolder_Click" />
                            <MenuItem x:Name="ContentMoveFolderMenuItem"
                                      Header="{DynamicResource ContextMoveFolderTo}"
                                      IsEnabled="{Binding CanMoveSelectedContentFolder}"
                                      Click="MoveContentFolder_Click" />
                            <MenuItem x:Name="ContentDeleteFolderMenuItem"
                                      Header="{DynamicResource ContextDeleteFolder}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedContentFolder}"
                                      Click="DeleteContentFolder_Click" />
                            <Separator x:Name="ContentFolderSeparator" />
                            <MenuItem x:Name="ContentRenameBookmarkMenuItem"
                                      Header="{DynamicResource ContextRenameBookmark}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedBookmark}"
                                      Click="RenameBookmark_Click" />
                            <MenuItem x:Name="ContentEditUrlMenuItem"
                                      Header="{DynamicResource ContextEditUrl}"
                                      InputGestureText="Ctrl+E"
                                      IsEnabled="{Binding CanEditSelectedBookmarkUrl}"
                                      Click="EditUrl_Click" />
                            <MenuItem x:Name="ContentMoveBookmarkMenuItem"
                                      Header="{DynamicResource ContextMoveTo}"
                                      IsEnabled="{Binding CanMoveSelectedBookmarks}"
                                      Click="MoveBookmark_Click" />
                            <MenuItem x:Name="ContentMoveSelectionMenuItem"
                                      Header="{DynamicResource ContextMoveSelectedItemsTo}"
                                      IsEnabled="{Binding CanMoveSelectedContentItems}"
                                      Visibility="Collapsed"
                                      Click="MoveSelectedContentItems_Click" />
                            <Separator x:Name="ContentBookmarkSeparator" />
                            <MenuItem x:Name="ContentDeleteBookmarkMenuItem"
                                      Header="{DynamicResource ContextDeleteBookmarks}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedBookmarks}"
                                      Click="DeleteSelectedBookmarks_Click" />
                            <MenuItem x:Name="ContentDeleteSelectionMenuItem"
                                      Header="{DynamicResource ContextDeleteSelectedItems}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedContentItems}"
                                      Visibility="Collapsed"
                                      Click="DeleteSelectedContentItems_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="30"><GridViewColumn.CellTemplate><DataTemplate><CheckBox Focusable="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Mode=TwoWay}" ToolTip="{DynamicResource WorkspaceSelectItem}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn x:Name="ContentNameColumn" Header="{DynamicResource ColumnName}"
                                            Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FolderGlyph"
                                                       Text="▱" Foreground="{DynamicResource WarningBrush}"
                                                       Margin="0,0,10,0"
                                                       Visibility="Collapsed" />
                                            <TextBlock x:Name="BookmarkGlyph"
                                                       Text="↗" Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,6,0"
                                                       Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}"
                                                         Value="True">
                                                <Setter TargetName="FolderGlyph"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBookmark}"
                                                         Value="True">
                                                <Setter TargetName="BookmarkGlyph"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ContentUrlColumn" Header="{DynamicResource ColumnUrl}"
                                            Width="310"
                                            ><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Url}" ToolTip="{Binding Url}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                            <Border Background="{DynamicResource AppBackgroundBrush}" Visibility="{Binding Workspace.IsEmptyDocument, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"><TextBlock Text="⌑" FontSize="38" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource WorkspaceEmptyTitle}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,8" /><TextBlock Text="{DynamicResource WorkspaceEmptyBody}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" /><Button Content="{DynamicResource ToolbarOpenBookmarks}" Click="OpenBookmarks_Click" IsEnabled="{Binding CanOpenBookmarks}" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0" /></StackPanel></Border>
                            <Border Background="{DynamicResource AppBackgroundBrush}" Visibility="{Binding Workspace.IsLoading, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{DynamicResource StatusReading}" FontSize="18" Margin="0,0,0,16" /><ProgressBar IsIndeterminate="True" Width="220" Height="4" /><Button Content="{DynamicResource WorkspaceCancelLoad}" IsEnabled="{Binding CanCancelLoad}" Click="CancelLoad_Click" HorizontalAlignment="Center" Margin="0,18,0,0" /></StackPanel></Border>
                            <TextBlock Text="{Binding Workspace.EmptyListMessage, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Visibility="{Binding Workspace.HasEmptyList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
            <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" HorizontalAlignment="Stretch" Width="5" Background="{DynamicResource BorderBrush}" />
            <Border x:Name="DetailsPanel" Grid.Column="4" Background="{DynamicResource SidebarBackgroundBrush}" Padding="16,17,14,12">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="ToggleDetails_Click" Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource WorkspaceCloseDetails}" /><TextBlock Text="{DynamicResource WorkspaceSelectedItem}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" /></DockPanel>
                    <Border Width="44" Height="44" Background="{DynamicResource SelectionBrush}" CornerRadius="10" HorizontalAlignment="Left" Margin="0,23,0,15"><TextBlock Text="{Binding Workspace.DetailGlyph, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="{Binding Workspace.DetailTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Workspace.DetailUrl, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <TextBlock Text="{DynamicResource WorkspaceLocation}" Style="{StaticResource QuietLabel}" Margin="0,22,0,6" />
                    <TextBlock Text="{Binding Workspace.DetailPath, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource WorkspaceItemActions}" Style="{StaticResource QuietLabel}" Margin="0,22,0,8" />
                    <WrapPanel>
                        <Button Content="{DynamicResource WorkspaceOpen}" IsEnabled="{Binding CanOpenSelectedContentItem}" Click="OpenContentBookmark_Click" Margin="0,0,5,6" />
                        <Button Content="{DynamicResource WorkspaceRename}" IsEnabled="{Binding Workspace.CanRenameDetail, RelativeSource={RelativeSource AncestorType=Window}}" Click="RenameDetail_Click" Margin="0,0,5,6" />
                        <Button Content="{DynamicResource WorkspaceEditUrl}" IsEnabled="{Binding CanEditSelectedBookmarkUrl}" Click="EditUrl_Click" Margin="0,0,5,6" />
                        <Button Content="{DynamicResource WorkspaceMove}" IsEnabled="{Binding CanMoveSelectedContentItems}" Click="MoveSelectedContentItems_Click" Margin="0,0,5,6" />
                        <Button Content="{DynamicResource WorkspaceDelete}" IsEnabled="{Binding CanDeleteSelectedContentItems}" Click="DeleteSelectedContentItems_Click" Style="{StaticResource DangerButtonStyle}" Margin="0,0,5,6" />
                    </WrapPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0"><StackPanel><TextBlock Text="{DynamicResource WorkspaceSafeSave}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" /><TextBlock Text="{DynamicResource WorkspaceSafeSaveNote}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <StatusBar Grid.Row="2" Padding="10,3" FontSize="10" Background="{DynamicResource SidebarBackgroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SearchSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DocumentSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding SourcePath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourcePath}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
