<Window x:Class="ChromeBookmarksManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:search="clr-namespace:ChromeBookmarksManager.Application.Search"
        Title="{Binding ApplicationTitle}"
        Icon="Assets/ChromeBookmarksManager.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuOpenBookmarks}"
                          IsEnabled="{Binding CanOpenBookmarks}"
                          Click="OpenBookmarks_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuImportBookmarksHtml}"
                          IsEnabled="{Binding CanImportBookmarksHtml}"
                          Click="ImportBookmarksHtml_Click" />
                <MenuItem Header="{DynamicResource MenuExportBookmarksHtml}"
                          IsEnabled="{Binding CanExportBookmarksHtml}"
                          Click="ExportBookmarksHtml_Click" />
                <MenuItem Header="{DynamicResource MenuSave}"
                          InputGestureText="Ctrl+S"
                          IsEnabled="{Binding CanSave}"
                          Click="Save_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuExit}"
                          Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuEdit}">
                <MenuItem Header="{DynamicResource MenuUndo}"
                          InputGestureText="Ctrl+Z"
                          IsEnabled="{Binding CanUndo}"
                          ToolTip="{Binding UndoDescription}"
                          Click="Undo_Click" />
                <MenuItem Header="{DynamicResource MenuRedo}"
                          InputGestureText="Ctrl+Y / Ctrl+Shift+Z"
                          IsEnabled="{Binding CanRedo}"
                          ToolTip="{Binding RedoDescription}"
                          Click="Redo_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuCut}"
                          InputGestureText="Ctrl+X"
                          IsEnabled="{Binding CanCutSelectedContentItems}"
                          Click="CutSelectedContentItems_Click" />
                <MenuItem Header="{DynamicResource MenuCopy}"
                          InputGestureText="Ctrl+C"
                          IsEnabled="{Binding CanCopySelectedContentItems}"
                          Click="CopySelectedContentItems_Click" />
                <MenuItem Header="{DynamicResource MenuPaste}"
                          InputGestureText="Ctrl+V"
                          IsEnabled="{Binding CanPasteClipboard}"
                          Click="PasteClipboard_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuAddBookmark}"
                          InputGestureText="Ctrl+Shift+B"
                          IsEnabled="{Binding CanAddBookmark}"
                          Click="AddBookmark_Click" />
                <MenuItem Header="{DynamicResource MenuAddBookmarksBatch}"
                          IsEnabled="{Binding CanAddBookmark}"
                          Click="AddBookmarksBatch_Click" />
                <MenuItem Header="{DynamicResource MenuAddFolder}"
                          InputGestureText="Ctrl+Shift+F"
                          IsEnabled="{Binding CanAddFolder}"
                          Click="AddFolder_Click" />
                <MenuItem Header="{DynamicResource MenuSortByName}"
                          IsEnabled="{Binding CanSortSelectedFolder}"
                          Click="SortSelectedFolder_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuRenameFolder}"
                          InputGestureText="F2"
                          IsEnabled="{Binding CanRenameSelectedFolder}"
                          Click="RenameFolder_Click" />
                <MenuItem Header="{DynamicResource MenuRenameBookmark}"
                          InputGestureText="F2"
                          IsEnabled="{Binding CanRenameSelectedBookmark}"
                          Click="RenameBookmark_Click" />
                <MenuItem Header="{DynamicResource MenuEditUrl}"
                          InputGestureText="Ctrl+E"
                          IsEnabled="{Binding CanEditSelectedBookmarkUrl}"
                          Click="EditUrl_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource MenuDeleteSelectedItems}"
                          InputGestureText="Delete"
                          IsEnabled="{Binding CanDeleteSelectedContentItems}"
                          Click="DeleteSelectedContentItems_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuLanguage}">
                <MenuItem x:Name="SimplifiedChineseMenuItem"
                          Header="{DynamicResource LanguageSimplifiedChinese}"
                          IsCheckable="True"
                          Click="SwitchToSimplifiedChinese_Click" />
                <MenuItem x:Name="EnglishMenuItem"
                          Header="{DynamicResource LanguageEnglish}"
                          IsCheckable="True"
                          Click="SwitchToEnglish_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Padding="10,8"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{DynamicResource ToolbarOpenBookmarks}"
                        Padding="16,6"
                        IsEnabled="{Binding CanOpenBookmarks}"
                        Click="OpenBookmarks_Click"
                        ToolTip="{DynamicResource TooltipOpenBookmarks}" />

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{DynamicResource ToolbarCancel}"
                        Padding="16,6"
                        IsEnabled="{Binding CanCancelLoad}"
                        Click="CancelLoad_Click"
                        ToolTip="{DynamicResource TooltipCancelLoad}" />

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="{DynamicResource ToolbarUndo}"
                        Padding="12,6"
                        IsEnabled="{Binding CanUndo}"
                        Click="Undo_Click"
                        ToolTip="{Binding UndoDescription}" />

                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Content="{DynamicResource ToolbarRedo}"
                        Padding="12,6"
                        IsEnabled="{Binding CanRedo}"
                        Click="Redo_Click"
                        ToolTip="{Binding RedoDescription}" />

                <Button Grid.Column="4"
                        Margin="8,0,8,0"
                        Content="{DynamicResource ToolbarSave}"
                        Padding="16,6"
                        IsEnabled="{Binding CanSave}"
                        Click="Save_Click"
                        ToolTip="{DynamicResource TooltipSave}" />

                <TextBox x:Name="SearchBox"
                         Grid.Column="5"
                         Margin="12,0,0,0"
                         Height="30"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding CanSearchDocument}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource TooltipSearch}" />

                <ComboBox Grid.Column="6"
                          Margin="8,0,0,0"
                          MinWidth="130"
                          Height="30"
                          VerticalContentAlignment="Center"
                          IsEnabled="{Binding CanSearchDocument}"
                          SelectedValue="{Binding SearchScope, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          ToolTip="{DynamicResource TooltipSearchScope}">
                    <ComboBoxItem Content="{DynamicResource SearchScopeAllBookmarks}"
                                  Tag="{x:Static search:BookmarkSearchScope.AllBookmarks}" />
                    <ComboBoxItem Content="{DynamicResource SearchScopeCurrentFolder}"
                                  Tag="{x:Static search:BookmarkSearchScope.CurrentFolder}" />
                </ComboBox>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SearchSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DocumentSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding SourcePath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourcePath}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{DynamicResource PanelFolders}" Margin="8">
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding FolderRoots}"
                          IsEnabled="{Binding CanBrowseDocument}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="FolderTree_PreviewMouseMove"
                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          DragOver="FolderTree_DragOver"
                          DragLeave="FolderTree_DragLeave"
                          Drop="FolderTree_Drop"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource ContextAddBookmark}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmark_Click" />
                            <MenuItem Header="{DynamicResource ContextAddBookmarksBatch}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmarksBatch_Click" />
                            <MenuItem Header="{DynamicResource ContextAddFolder}"
                                      IsEnabled="{Binding CanAddFolder}"
                                      Click="AddFolder_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ContextRenameFolder}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedFolder}"
                                      Click="RenameFolder_Click" />
                            <MenuItem Header="{DynamicResource ContextMoveTo}"
                                      IsEnabled="{Binding CanMoveSelectedFolder}"
                                      Click="MoveFolder_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ContextDeleteFolder}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedFolder}"
                                      Click="DeleteSelectedFolder_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="{DynamicResource PanelContents}" Margin="8">
                <ListView x:Name="BookmarksList"
                          ItemsSource="{Binding DisplayedItems}"
                          SelectionChanged="BookmarksList_SelectionChanged"
                          MouseDoubleClick="BookmarksList_MouseDoubleClick"
                          KeyDown="BookmarksList_KeyDown"
                          PreviewMouseLeftButtonDown="BookmarksList_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="BookmarksList_PreviewMouseMove"
                          PreviewMouseRightButtonDown="BookmarksList_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          DragOver="BookmarksList_DragOver"
                          DragLeave="BookmarksList_DragLeave"
                          Drop="BookmarksList_Drop"
                          SelectionMode="Extended"
                          IsEnabled="{Binding CanBrowseDocument}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Opened="BookmarksContextMenu_Opened">
                            <MenuItem x:Name="ContentOpenFolderMenuItem"
                                      Header="{DynamicResource ContextOpenFolder}"
                                      IsEnabled="{Binding CanOpenSelectedContentItem}"
                                      Click="OpenContentFolder_Click" />
                            <MenuItem x:Name="ContentOpenBookmarkMenuItem"
                                      Header="{DynamicResource ContextOpenBookmark}"
                                      IsEnabled="{Binding CanOpenSelectedContentItem}"
                                      Visibility="Collapsed"
                                      Click="OpenContentBookmark_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ContextCut}"
                                      InputGestureText="Ctrl+X"
                                      IsEnabled="{Binding CanCutSelectedContentItems}"
                                      Click="CutSelectedContentItems_Click" />
                            <MenuItem Header="{DynamicResource ContextCopy}"
                                      InputGestureText="Ctrl+C"
                                      IsEnabled="{Binding CanCopySelectedContentItems}"
                                      Click="CopySelectedContentItems_Click" />
                            <MenuItem Header="{DynamicResource ContextPaste}"
                                      InputGestureText="Ctrl+V"
                                      IsEnabled="{Binding CanPasteClipboard}"
                                      Click="PasteClipboard_Click" />
                            <MenuItem x:Name="ContentAddBookmarksBatchMenuItem"
                                      Header="{DynamicResource ContextAddBookmarksBatch}"
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmarksBatch_Click" />
                            <Separator />
                            <MenuItem x:Name="ContentRenameFolderMenuItem"
                                      Header="{DynamicResource ContextRenameFolder}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedContentFolder}"
                                      Click="RenameContentFolder_Click" />
                            <MenuItem x:Name="ContentMoveFolderMenuItem"
                                      Header="{DynamicResource ContextMoveFolderTo}"
                                      IsEnabled="{Binding CanMoveSelectedContentFolder}"
                                      Click="MoveContentFolder_Click" />
                            <MenuItem x:Name="ContentDeleteFolderMenuItem"
                                      Header="{DynamicResource ContextDeleteFolder}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedContentFolder}"
                                      Click="DeleteContentFolder_Click" />
                            <Separator x:Name="ContentFolderSeparator" />
                            <MenuItem x:Name="ContentRenameBookmarkMenuItem"
                                      Header="{DynamicResource ContextRenameBookmark}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedBookmark}"
                                      Click="RenameBookmark_Click" />
                            <MenuItem x:Name="ContentEditUrlMenuItem"
                                      Header="{DynamicResource ContextEditUrl}"
                                      InputGestureText="Ctrl+E"
                                      IsEnabled="{Binding CanEditSelectedBookmarkUrl}"
                                      Click="EditUrl_Click" />
                            <MenuItem x:Name="ContentMoveBookmarkMenuItem"
                                      Header="{DynamicResource ContextMoveTo}"
                                      IsEnabled="{Binding CanMoveSelectedBookmarks}"
                                      Click="MoveBookmark_Click" />
                            <MenuItem x:Name="ContentMoveSelectionMenuItem"
                                      Header="{DynamicResource ContextMoveSelectedItemsTo}"
                                      IsEnabled="{Binding CanMoveSelectedContentItems}"
                                      Visibility="Collapsed"
                                      Click="MoveSelectedContentItems_Click" />
                            <Separator x:Name="ContentBookmarkSeparator" />
                            <MenuItem x:Name="ContentDeleteBookmarkMenuItem"
                                      Header="{DynamicResource ContextDeleteBookmarks}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedBookmarks}"
                                      Click="DeleteSelectedBookmarks_Click" />
                            <MenuItem x:Name="ContentDeleteSelectionMenuItem"
                                      Header="{DynamicResource ContextDeleteSelectedItems}"
                                      InputGestureText="Delete"
                                      IsEnabled="{Binding CanDeleteSelectedContentItems}"
                                      Visibility="Collapsed"
                                      Click="DeleteSelectedContentItems_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource ColumnName}"
                                            Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FolderGlyph"
                                                       Text="📁"
                                                       Margin="0,0,6,0"
                                                       Visibility="Collapsed" />
                                            <TextBlock x:Name="BookmarkGlyph"
                                                       Text="🔖"
                                                       Margin="0,0,6,0"
                                                       Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}"
                                                         Value="True">
                                                <Setter TargetName="FolderGlyph"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBookmark}"
                                                         Value="True">
                                                <Setter TargetName="BookmarkGlyph"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource ColumnUrl}"
                                            Width="520"
                                            DisplayMemberBinding="{Binding Url}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
