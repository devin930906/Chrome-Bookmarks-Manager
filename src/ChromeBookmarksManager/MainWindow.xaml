<Window x:Class="ChromeBookmarksManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:search="clr-namespace:ChromeBookmarksManager.Application.Search"
        Title="{Binding ApplicationTitle}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Bookmarks..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Edit" IsEnabled="False" />
            <MenuItem Header="_View" />
            <MenuItem Header="_Tools" IsEnabled="False" />
        </Menu>

        <Border DockPanel.Dock="Top"
                Padding="10,8"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Open Bookmarks"
                        Padding="16,6"
                        IsEnabled="{Binding CanOpenBookmarks}"
                        Click="OpenBookmarks_Click"
                        ToolTip="Open a Chrome Bookmarks file in read-only mode." />

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Cancel"
                        Padding="16,6"
                        IsEnabled="{Binding CanCancelLoad}"
                        Click="CancelLoad_Click"
                        ToolTip="Cancel the current Bookmarks load." />

                <TextBox x:Name="SearchBox"
                         Grid.Column="3"
                         Margin="12,0,0,0"
                         Height="30"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding CanSearchDocument}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search bookmark names and URLs. Ctrl+F focuses search; Escape clears it." />

                <ComboBox Grid.Column="4"
                          Margin="8,0,0,0"
                          MinWidth="130"
                          Height="30"
                          VerticalContentAlignment="Center"
                          IsEnabled="{Binding CanSearchDocument}"
                          SelectedValue="{Binding SearchScope, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          ToolTip="Choose whether to search all bookmarks or only the selected folder.">
                    <ComboBoxItem Content="All bookmarks"
                                  Tag="{x:Static search:BookmarkSearchScope.AllBookmarks}" />
                    <ComboBoxItem Content="Current folder"
                                  Tag="{x:Static search:BookmarkSearchScope.CurrentFolder}" />
                </ComboBox>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SearchSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DocumentSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding SourcePath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourcePath}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Folders" Margin="8">
                <TreeView ItemsSource="{Binding FolderRoots}"
                          IsEnabled="{Binding CanBrowseDocument}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="Bookmarks" Margin="8">
                <ListView x:Name="BookmarksList"
                          ItemsSource="{Binding DisplayedBookmarks}"
                          SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                          MouseDoubleClick="BookmarksList_MouseDoubleClick"
                          KeyDown="BookmarksList_KeyDown"
                          SelectionMode="Single"
                          IsEnabled="{Binding CanBrowseDocument}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"
                                            Width="280"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="URL"
                                            Width="520"
                                            DisplayMemberBinding="{Binding Url}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
