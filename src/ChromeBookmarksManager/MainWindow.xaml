<Window x:Class="ChromeBookmarksManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:search="clr-namespace:ChromeBookmarksManager.Application.Search"
        Title="{Binding ApplicationTitle}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Bookmarks..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Add _Bookmark..."
                          InputGestureText="Ctrl+Shift+B"
                          IsEnabled="{Binding CanAddBookmark}"
                          Click="AddBookmark_Click" />
                <MenuItem Header="Add _Folder..."
                          InputGestureText="Ctrl+Shift+F"
                          IsEnabled="{Binding CanAddFolder}"
                          Click="AddFolder_Click" />
                <Separator />
                <MenuItem Header="_Rename Folder..."
                          InputGestureText="F2"
                          IsEnabled="{Binding CanRenameSelectedFolder}"
                          Click="RenameFolder_Click" />
                <MenuItem Header="Rename _Bookmark..."
                          InputGestureText="F2"
                          IsEnabled="{Binding CanRenameSelectedBookmark}"
                          Click="RenameBookmark_Click" />
                <MenuItem Header="Edit _URL..."
                          InputGestureText="Ctrl+E"
                          IsEnabled="{Binding CanEditSelectedBookmarkUrl}"
                          Click="EditUrl_Click" />
            </MenuItem>
            <MenuItem Header="_View" />
            <MenuItem Header="_Tools" IsEnabled="False" />
        </Menu>

        <Border DockPanel.Dock="Top"
                Padding="10,8"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Open Bookmarks"
                        Padding="16,6"
                        IsEnabled="{Binding CanOpenBookmarks}"
                        Click="OpenBookmarks_Click"
                        ToolTip="Open a Chrome Bookmarks file. V0.6 edits and moves remain in memory." />

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Cancel"
                        Padding="16,6"
                        IsEnabled="{Binding CanCancelLoad}"
                        Click="CancelLoad_Click"
                        ToolTip="Cancel the current Bookmarks load." />

                <TextBlock Grid.Column="2"
                           Margin="16,0,8,0"
                           VerticalAlignment="Center"
                           Text="V0.6 editing and moving are in-memory only; Save is not available yet."
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Edits and moves are kept in memory only. Closing or replacing the document will require discarding them until safe save support is added." />

                <TextBox x:Name="SearchBox"
                         Grid.Column="3"
                         Margin="12,0,0,0"
                         Height="30"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding CanSearchDocument}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search bookmark names and URLs. Ctrl+F focuses search; Escape clears it." />

                <ComboBox Grid.Column="4"
                          Margin="8,0,0,0"
                          MinWidth="130"
                          Height="30"
                          VerticalContentAlignment="Center"
                          IsEnabled="{Binding CanSearchDocument}"
                          SelectedValue="{Binding SearchScope, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          ToolTip="Choose whether to search all bookmarks or only the selected folder.">
                    <ComboBoxItem Content="All bookmarks"
                                  Tag="{x:Static search:BookmarkSearchScope.AllBookmarks}" />
                    <ComboBoxItem Content="Current folder"
                                  Tag="{x:Static search:BookmarkSearchScope.CurrentFolder}" />
                </ComboBox>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SearchSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DocumentSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding SourcePath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourcePath}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Folders" Margin="8">
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding FolderRoots}"
                          IsEnabled="{Binding CanBrowseDocument}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          DragOver="FolderTree_DragOver"
                          DragLeave="FolderTree_DragLeave"
                          Drop="FolderTree_Drop"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Add Bookmark..."
                                      IsEnabled="{Binding CanAddBookmark}"
                                      Click="AddBookmark_Click" />
                            <MenuItem Header="Add Folder..."
                                      IsEnabled="{Binding CanAddFolder}"
                                      Click="AddFolder_Click" />
                            <Separator />
                            <MenuItem Header="Rename Folder..."
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedFolder}"
                                      Click="RenameFolder_Click" />
                            <MenuItem Header="Move to..."
                                      IsEnabled="{Binding CanMoveSelectedFolder}"
                                      Click="MoveFolder_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="Bookmarks" Margin="8">
                <ListView x:Name="BookmarksList"
                          ItemsSource="{Binding DisplayedBookmarks}"
                          SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                          MouseDoubleClick="BookmarksList_MouseDoubleClick"
                          KeyDown="BookmarksList_KeyDown"
                          PreviewMouseLeftButtonDown="BookmarksList_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="BookmarksList_PreviewMouseMove"
                          PreviewMouseRightButtonDown="BookmarksList_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          DragOver="BookmarksList_DragOver"
                          DragLeave="BookmarksList_DragLeave"
                          Drop="BookmarksList_Drop"
                          SelectionMode="Single"
                          IsEnabled="{Binding CanBrowseDocument}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Rename Bookmark..."
                                      InputGestureText="F2"
                                      IsEnabled="{Binding CanRenameSelectedBookmark}"
                                      Click="RenameBookmark_Click" />
                            <MenuItem Header="Edit URL..."
                                      InputGestureText="Ctrl+E"
                                      IsEnabled="{Binding CanEditSelectedBookmarkUrl}"
                                      Click="EditUrl_Click" />
                            <MenuItem Header="Move to..."
                                      IsEnabled="{Binding CanMoveSelectedBookmark}"
                                      Click="MoveBookmark_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"
                                            Width="280"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="URL"
                                            Width="520"
                                            DisplayMemberBinding="{Binding Url}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
